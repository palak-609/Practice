
package day5;

public class Array2sum {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		int arr[]= {1,2,3,4,5};
		int sum=9,f=0;
		
		for(int i=0;i<5;i++) {
			int n1=arr[i];
			int n2=sum-n1;
			
			for(int n:arr) {
				if(n==n2) {
					System.out.println("["+n1+","+n2+"]"); 
					f=1;
				    break;
				    }
			}
		}
		if(f==0) System.out.println("No such pair found!");

	}

}
